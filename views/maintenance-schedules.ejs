<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Maintenance Schedules | MaintainXPro</title>

  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- Navigation Bar -->
  <%- include("partials/navbar") %>

  <main class="container py-5 equipment-page">

  <!-- PAGE HEADER -->
  <section class="equipment-hero mb-4">
    <div class="equipment-hero-content">
      <span class="equipment-eyebrow">MAINTENANCE MANAGEMENT</span>

      <h1 class="equipment-heading">Maintenance Schedules</h1>

      <p class="equipment-subtitle">
        Monitor planned maintenance activities, track upcoming schedules,
        and keep your equipment operating efficiently.
      </p>
    </div>

    <% if (
      currentUser &&
      ["Admin", "Maintenance Manager"].includes(currentUser.role)
    ) { %>
      <a href="/maintenance-schedules/new" class="equipment-primary-btn">
        + Add Schedule
      </a>
    <% } %>
  </section>


  <!-- SUCCESS MESSAGE -->
 
  <% if (success === "created") { %>
    <div class="alert alert-success alert-dismissible fade show equipment-alert mb-4" role="alert">
      Maintenance schedule added successfully.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } else if (success === "updated") { %>
    <div class="alert alert-success alert-dismissible fade show equipment-alert mb-4" role="alert">
      Maintenance schedule updated successfully.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } else if (success === "deleted") { %>
    <div class="alert alert-success alert-dismissible fade show equipment-alert mb-4" role="alert">
      Maintenance schedule deleted successfully.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  
  <!-- FILTER PANEL -->
  <section class="equipment-panel mb-4">

    <div class="equipment-panel-header">
      <div>
        <span class="equipment-panel-eyebrow">RECORD FILTERS</span>
        <h2>Find Maintenance Schedules</h2>
        <p>Search and filter your maintenance records.</p>
      </div>
    </div>

    <form action="/maintenance-schedules" method="GET">

      <div class="row g-3 align-items-end">

        <!-- SEARCH -->
        <div class="col-lg-4 col-md-12">
          <label for="search" class="form-label">
            Search
          </label>

          <input
            type="text"
            id="search"
            name="search"
            class="form-control equipment-input"
            placeholder="Search task or equipment..."
            value="<%= search || '' %>"
          >
        </div>


        <!-- FREQUENCY -->
        <div class="col-lg-3 col-md-6">
          <label for="frequency" class="form-label">
            Frequency
          </label>

          <select
            id="frequency"
            name="frequency"
            class="form-select equipment-input"
          >
            <option value="">All Frequencies</option>

            <option value="Daily" <%= frequency === "Daily" ? "selected" : "" %>>
              Daily
            </option>

            <option value="Weekly" <%= frequency === "Weekly" ? "selected" : "" %>>
              Weekly
            </option>

            <option value="Monthly" <%= frequency === "Monthly" ? "selected" : "" %>>
              Monthly
            </option>

            <option value="Quarterly" <%= frequency === "Quarterly" ? "selected" : "" %>>
              Quarterly
            </option>

            <option value="Semi-annually" <%= frequency === "Semi-annually" ? "selected" : "" %>>
              Semi-annually
            </option>

            <option value="Annually" <%= frequency === "Annually" ? "selected" : "" %>>
              Annually
            </option>
          </select>
        </div>


        <!-- STATUS -->
        <div class="col-lg-3 col-md-6">
          <label for="status" class="form-label">
            Status
          </label>

          <select
            id="status"
            name="status"
            class="form-select equipment-input"
          >
            <option value="" <%= status === "" ? "selected" : "" %>>
              All Statuses
            </option>

            <option value="Overdue" <%= status === "Overdue" ? "selected" : "" %>>
              Overdue
            </option>

            <option value="Due Soon" <%= status === "Due Soon" ? "selected" : "" %>>
              Due Soon
            </option>

            <option value="Upcoming" <%= status === "Upcoming" ? "selected" : "" %>>
              Upcoming
            </option>
          </select>
        </div>


        <!-- FILTER BUTTONS -->
        <div class="col-lg-2 col-md-12">
          <div class="d-flex gap-2 equipment-filter-actions">

            <button
              type="submit"
              class="equipment-primary-btn equipment-search-btn"
            >
              Filter
            </button>

            <a
              href="/maintenance-schedules"
              class="equipment-clear-btn"
            >
              Clear
            </a>

          </div>
        </div>

      </div>
    </form>

  </section>


  <!-- MAINTENANCE SCHEDULES TABLE -->
  <section class="equipment-panel">

    <div class="equipment-panel-header inventory-header">

      <div>
        <span class="equipment-panel-eyebrow">SCHEDULE DATABASE</span>
        <h2>Maintenance Records</h2>
        <p>View and manage all scheduled maintenance activities.</p>
      </div>

      <span class="equipment-record-count">
        <%= schedules.length %> Records
      </span>

    </div>


    <div class="table-responsive equipment-table-wrap">

      <table class="table table-hover align-middle mb-0 equipment-table">

        <thead>
          <tr>
            <th>ID</th>
            <th>Equipment</th>
            <th>Maintenance Task</th>
            <th>Frequency</th>
            <th>Next Maintenance</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>

          <% if (schedules.length === 0) { %>

            <tr>
              <td colspan="7">

                <div class="equipment-empty-state">

                  <div class="equipment-empty-icon">
                    &#128197;
                  </div>

                  <h3>No Maintenance Schedules Found</h3>

                  <p>
                    No records match your search or filter criteria.
                  </p>

                  <% if (
                    currentUser &&
                    ["Admin", "Maintenance Manager"].includes(currentUser.role)
                  ) { %>
                    <a
                      href="/maintenance-schedules/new"
                      class="equipment-primary-btn"
                    >
                      + Add Schedule
                    </a>
                  <% } %>

                </div>

              </td>
            </tr>

          <% } else { %>

            <% schedules.forEach(schedule => {

              const maintenanceDate = new Date(schedule.next_maintenance_date)
                .toISOString()
                .split("T")[0];

              const today = new Date().toISOString().split("T")[0];

              const maintenanceDay = new Date(`${maintenanceDate}T00:00:00Z`);
              const todayDay = new Date(`${today}T00:00:00Z`);

              const daysUntilMaintenance = Math.floor(
                (maintenanceDay.getTime() - todayDay.getTime()) / 86400000
              );

              let scheduleStatus;
              let statusClass;

              if (daysUntilMaintenance < 0) {
                scheduleStatus = "Overdue";
                statusClass = "badge-offline";
              } else if (daysUntilMaintenance <= 7) {
                scheduleStatus = "Due Soon";
                statusClass = "badge-maintenance";
              } else {
                scheduleStatus = "Upcoming";
                statusClass = "badge-operational";
              }

            %>

              <tr>

                <!-- ID -->
                <td>
                  <span class="equipment-id">
                    #<%= schedule.id %>
                  </span>
                </td>


                <!-- EQUIPMENT -->
                <td>
                  <div class="equipment-name">
                    <%= schedule.equipment_name %>
                  </div>

                  <div class="equipment-code">
                    <%= schedule.equipment_code %>
                  </div>
                </td>


                <!-- MAINTENANCE TASK -->
                <td>
                  <span class="equipment-category">
                    <%= schedule.title %>
                  </span>
                </td>


                <!-- FREQUENCY -->
                <td>
                  <span class="equipment-category">
                    <%= schedule.frequency %>
                  </span>
                </td>


                <!-- NEXT MAINTENANCE -->
                <td>
                  <span class="equipment-location">
                    <%= maintenanceDate %>
                  </span>
                </td>


                <!-- STATUS -->
                <td>
                  <span class="equipment-badge <%= statusClass %>">
                    <span></span>
                    <%= scheduleStatus %>
                  </span>
                </td>


                <!-- ACTIONS -->
                <td>

                  <% if (
                    currentUser &&
                    (
                      ["Admin", "Maintenance Manager"].includes(currentUser.role) ||
                      (
                        currentUser.role === "Technician" &&
                        schedule.assigned_to === currentUser.id
                      )
                    )
                  ) { %>

                    <div class="equipment-row-actions">

                      <a
                        href="/maintenance-schedules/<%= schedule.id %>/edit"
                        class="equipment-action-btn action-edit"
                      >
                        Edit
                      </a>

                      <% if (
                        ["Admin", "Maintenance Manager"].includes(currentUser.role)
                      ) { %>

                        <form
                          action="/maintenance-schedules/<%= schedule.id %>/delete"
                          method="POST"
                          class="delete-confirm-form"
                          data-delete-message="Are you sure you want to delete this maintenance schedule? This action cannot be undone."
                        >
                          <button
                            type="submit"
                            class="equipment-action-btn action-delete"
                          >
                            Delete
                          </button>
                        </form>

                      <% } %>

                    </div>

                  <% } else { %>

                    <span class="equipment-id">
                      View only
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }); %>

          <% } %>

        </tbody>

      </table>

    </div>

  </section>

</main>

  <!-- Footer -->
  <%- include("partials/footer") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>