<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>Equipment Management | MaintainXPro</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

<link rel="stylesheet" href="/css/style.css">


</head>

<body>
    <%- include("partials/navbar") %>


<main class="container py-5 equipment-page">

    <!-- Page Header -->
    <section class="equipment-hero mb-4">
        <div class="equipment-hero-content">
            <span class="equipment-eyebrow">ASSET MANAGEMENT</span>

            <h1 class="equipment-heading">Equipment.</h1>

            <p class="equipment-subtitle">
                Monitor, organize, and manage your organization's equipment
                from one central inventory.
            </p>
        </div>

        <% if (
            currentUser.role === "Admin" ||
            currentUser.role === "Maintenance Manager"
        ) { %>
            <a href="/equipment/new" class="equipment-primary-btn">
                <span aria-hidden="true">+</span>
                Add Equipment
            </a>
        <% } %>
    </section>

    <!-- Equipment Statistics -->
    <section class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="equipment-stat-card">
                <div class="equipment-stat-top">
                    <span class="equipment-stat-label">TOTAL EQUIPMENT</span>
                    <span class="equipment-stat-icon">01</span>
                </div>

                <h2><%= statistics.total %></h2>
                <p>Registered assets</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="equipment-stat-card">
                <div class="equipment-stat-top">
                    <span class="equipment-stat-label">OPERATIONAL</span>
                    <span class="equipment-status-dot operational-dot"></span>
                </div>

                <h2><%= statistics.operational %></h2>
                <p>Equipment in service</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="equipment-stat-card">
                <div class="equipment-stat-top">
                    <span class="equipment-stat-label">UNDER MAINTENANCE</span>
                    <span class="equipment-status-dot maintenance-dot"></span>
                </div>

                <h2><%= statistics.under_maintenance %></h2>
                <p>Currently being serviced</p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="equipment-stat-card">
                <div class="equipment-stat-top">
                    <span class="equipment-stat-label">OUT OF SERVICE</span>
                    <span class="equipment-status-dot offline-dot"></span>
                </div>

                <h2><%= statistics.out_of_service %></h2>
                <p>Requires attention</p>
            </div>
        </div>

    </section>

    <!-- Success Messages -->
    <% if (
        success === "created" ||
        success === "updated" ||
        success === "deleted"
    ) { %>

        <div
            class="alert alert-success alert-dismissible fade show equipment-alert mb-4"
            role="alert"
        >
            <strong>Success!</strong>

            <%= success === "created"
                ? "Equipment registered successfully."
                : success === "updated"
                ? "Equipment updated successfully."
                : "Equipment deleted successfully." %>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"
            ></button>
        </div>

    <% } %>

    <!-- Search and Filters -->
    <section class="equipment-panel mb-4">

        <div class="equipment-panel-header">
            <div>
                <span class="equipment-panel-eyebrow">FIND ASSETS</span>
                <h2>Search & Filters</h2>
                <p>Find equipment by name, code, category, or status.</p>
            </div>
        </div>

        <form action="/equipment" method="GET">
            <div class="row g-3 align-items-end">

                <!-- Search -->
                <div class="col-12 col-lg-4">
                    <label for="search" class="form-label">
                        Search Equipment
                    </label>

                    <input
                        type="search"
                        id="search"
                        name="search"
                        class="form-control equipment-input"
                        placeholder="Search by code or name..."
                        value="<%= search || '' %>"
                    >
                </div>

                <!-- Category -->
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="category" class="form-label">
                        Category
                    </label>

                    <select
                        id="category"
                        name="category"
                        class="form-select equipment-input"
                    >
                        <option value="" <%= category === "" ? "selected" : "" %>>
                            All Categories
                        </option>

                        <option value="Electrical" <%= category === "Electrical" ? "selected" : "" %>>
                            Electrical
                        </option>

                        <option value="HVAC" <%= category === "HVAC" ? "selected" : "" %>>
                            HVAC
                        </option>

                        <option value="Mechanical" <%= category === "Mechanical" ? "selected" : "" %>>
                            Mechanical
                        </option>
                    </select>
                </div>

                <!-- Status -->
                <div class="col-12 col-md-6 col-lg-2">
                    <label for="status" class="form-label">
                        Status
                    </label>

                    <select
                        id="status"
                        name="status"
                        class="form-select equipment-input"
                    >
                        <option value="" <%= status === "" ? "selected" : "" %>>
                            All Statuses
                        </option>

                        <option value="Operational" <%= status === "Operational" ? "selected" : "" %>>
                            Operational
                        </option>

                        <option value="Under Maintenance" <%= status === "Under Maintenance" ? "selected" : "" %>>
                            Under Maintenance
                        </option>

                        <option value="Out of Service" <%= status === "Out of Service" ? "selected" : "" %>>
                            Out of Service
                        </option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="col-12 col-lg-3">
                    <div class="d-flex gap-2 equipment-filter-actions">

                        <button
                            type="submit"
                            class="equipment-primary-btn equipment-search-btn"
                        >
                            Search
                        </button>

                        <a
                            href="/equipment"
                            class="equipment-clear-btn"
                        >
                            Clear
                        </a>

                    </div>
                </div>

            </div>
        </form>

    </section>

    <!-- Equipment Inventory -->
    <section class="equipment-panel">

        <div class="equipment-panel-header inventory-header">
            <div>
                <span class="equipment-panel-eyebrow">ASSET REGISTER</span>
                <h2>Equipment Inventory</h2>
                <p>View and manage your equipment records.</p>
            </div>

            <span class="equipment-record-count">
                <%= equipment.length %> record<%= equipment.length === 1 ? "" : "s" %>
            </span>
        </div>

        <div class="table-responsive equipment-table-wrap">
            <table class="table table-hover align-middle mb-0 equipment-table">

                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">EQUIPMENT</th>
                        <th scope="col">CATEGORY</th>
                        <th scope="col">LOCATION</th>
                        <th scope="col">STATUS</th>
                        <th scope="col">ACTIONS</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (equipment.length > 0) { %>

                        <% equipment.forEach((item) => { %>

                            <tr>
                                <td>
                                    <span class="equipment-id">
                                        #<%= item.id %>
                                    </span>
                                </td>

                                <td>
                                    <div class="equipment-name">
                                        <%= item.name %>
                                    </div>

                                    <div class="equipment-code">
                                        <%= item.equipment_code %>
                                    </div>
                                </td>

                                <td>
                                    <span class="equipment-category">
                                        <%= item.category || "Not specified" %>
                                    </span>
                                </td>

                                <td>
                                    <span class="equipment-location">
                                        <%= item.location || "Not specified" %>
                                    </span>
                                </td>

                                <td>
                                    <% if (item.status === "Operational") { %>

                                        <span class="equipment-badge badge-operational">
                                            <span></span>
                                            Operational
                                        </span>

                                    <% } else if (item.status === "Under Maintenance") { %>

                                        <span class="equipment-badge badge-maintenance">
                                            <span></span>
                                            Under Maintenance
                                        </span>

                                    <% } else if (item.status === "Out of Service") { %>

                                        <span class="equipment-badge badge-offline">
                                            <span></span>
                                            Out of Service
                                        </span>

                                    <% } else { %>

                                        <span class="equipment-badge badge-unknown">
                                            <span></span>
                                            <%= item.status %>
                                        </span>

                                    <% } %>
                                </td>

                                <td>
                                    <div class="equipment-row-actions">

                                        <a
                                            href="/equipment/<%= item.id %>"
                                            class="equipment-action-btn action-details"
                                        >
                                            Details
                                        </a>

                                        <% if (
                                            currentUser.role === "Admin" ||
                                            currentUser.role === "Maintenance Manager"
                                        ) { %>

                                            <a
                                                href="/equipment/<%= item.id %>/edit"
                                                class="equipment-action-btn action-edit"
                                            >
                                                Edit
                                            </a>

                                            <form
                                                action="/equipment/<%= item.id %>/delete"
                                                method="POST"
                                                class="delete-confirm-form"
                                                data-delete-message="Are you sure you want to delete this equipment? This action cannot be undone"
                                            >
                                                <button
                                                    type="submit"
                                                    class="equipment-action-btn action-delete"
                                                >
                                                    Delete
                                                </button>
                                            </form>

                                        <% } %>

                                    </div>
                                </td>
                            </tr>

                        <% }); %>

                    <% } else { %>

                        <tr>
                            <td colspan="6">
                                <div class="equipment-empty-state">
                                    <div class="equipment-empty-icon">—</div>

                                    <h3>No Equipment Found</h3>

                                    <p>
                                        No equipment matches your current search
                                        or filters.
                                    </p>

                                    <% if (search || category || status) { %>

                                        <a
                                            href="/equipment"
                                            class="equipment-clear-btn"
                                        >
                                            Clear Filters
                                        </a>

                                    <% } else if (
                                        currentUser.role === "Admin" ||
                                        currentUser.role === "Maintenance Manager"
                                    ) { %>

                                        <a
                                            href="/equipment/new"
                                            class="equipment-primary-btn"
                                        >
                                            + Add Your First Equipment
                                        </a>

                                    <% } %>
                                </div>
                            </td>
                        </tr>

                    <% } %>
                </tbody>

            </table>
        </div>

    </section>

</main>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
