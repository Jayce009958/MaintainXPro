<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>500 | Server Error - MaintainXPro</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <link rel="stylesheet" href="/css/style.css" />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <%- include("partials/navbar") %>
    <main class="container py-5 error-page">
      <div class="row justify-content-center align-items-center">
        <div class="col-12 col-lg-9">
          <section class="error-card text-center">
            <!-- Error Icon -->
            <div class="error-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="42"
                height="42"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v4m0 4h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3l-7.5-13.1a2 2 0 0 0-3.4 0Z"
                />
              </svg>
            </div>

            <!-- Error Content -->
            <div class="error-eyebrow">SYSTEM NOTIFICATION</div>

            <h1 class="error-code">500</h1>

            <h2 class="error-title">Internal Server Error</h2>

            <p class="error-description">
              Something unexpected happened while processing your request. Our
              system encountered a problem. Please try again later.
            </p>

            <div class="error-divider"></div>

            <!-- Navigation Buttons -->
            <div class="error-actions">
              <a href="/" class="error-secondary-btn"> Back to Home </a>

              <a href="/dashboard" class="error-primary-btn">
                Go to Dashboard
                <span>&rarr;</span>
              </a>
            </div>

            <p class="error-reference">
              MAINTAINXPRO &bull; INTERNAL SERVER ERROR
            </p>
          </section>
        </div>
      </div>
    </main>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
