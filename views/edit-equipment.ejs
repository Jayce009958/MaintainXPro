<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Equipment | MaintainXPro</title>

  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- Navigation Bar -->
  <%- include("partials/navbar") %>

  <main class="container py-5 equipment-edit-page">

    <!-- Page Header -->
    <div class="equipment-edit-header mb-4">
      <a href="/equipment" class="equipment-edit-back">
        &larr; Back to Equipment
      </a>

      <div class="mt-3">
        <span class="equipment-edit-eyebrow">
          EQUIPMENT MANAGEMENT
        </span>

        <h1 class="equipment-edit-title">
          Edit Equipment
        </h1>

        <p class="equipment-edit-description">
          Update equipment details and keep your maintenance records accurate.
        </p>
      </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4">

      <!-- Edit Form -->
      <div class="col-lg-8">

        <div class="equipment-edit-card">

          <div class="equipment-edit-card-header">
            <div class="equipment-edit-icon">
              &#9998;
            </div>

            <div>
              <h5>Equipment Information</h5>
              <p>Modify the details of this equipment record.</p>
            </div>
          </div>

          <form
            action="/equipment/<%= equipment.id %>/edit"
            method="POST"
          >

            <div class="equipment-edit-form-body">

              <!-- Equipment Code -->
              <div class="mb-4">
                <label for="equipment_code" class="form-label">
                  Equipment Code <span class="required-mark">*</span>
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="equipment_code"
                  name="equipment_code"
                  value="<%= equipment.equipment_code %>"
                  placeholder="e.g. EQ-001"
                  required
                >

                <div class="form-text">
                  Use a unique code to identify this equipment.
                </div>
              </div>

              <!-- Equipment Name -->
              <div class="mb-4">
                <label for="name" class="form-label">
                  Equipment Name <span class="required-mark">*</span>
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="name"
                  name="name"
                  value="<%= equipment.name %>"
                  placeholder="Enter equipment name"
                  required
                >
              </div>

              <!-- Category and Location -->
              <div class="row g-3">

                <div class="col-md-6">
                  <label for="category" class="form-label">
                    Category
                  </label>

                  <input
                    type="text"
                    class="form-control"
                    id="category"
                    name="category"
                    value="<%= equipment.category || '' %>"
                    placeholder="e.g. Electrical"
                  >
                </div>

                <div class="col-md-6">
                  <label for="location" class="form-label">
                    Location
                  </label>

                  <input
                    type="text"
                    class="form-control"
                    id="location"
                    name="location"
                    value="<%= equipment.location || '' %>"
                    placeholder="e.g. Building A"
                  >
                </div>

              </div>

              <!-- Status -->
              <div class="mt-4 mb-3">
                <label for="status" class="form-label">
                  Equipment Status <span class="required-mark">*</span>
                </label>

                <select
                  class="form-select"
                  id="status"
                  name="status"
                  required
                >
                  <option
                    value="Operational"
                    <%= equipment.status === "Operational" ? "selected" : "" %>
                  >
                    Operational
                  </option>

                  <option
                    value="Under Maintenance"
                    <%= equipment.status === "Under Maintenance" ? "selected" : "" %>
                  >
                    Under Maintenance
                  </option>

                  <option
                    value="Out of Service"
                    <%= equipment.status === "Out of Service" ? "selected" : "" %>
                  >
                    Out of Service
                  </option>
                </select>

                <div class="form-text">
                  Select the current operating condition of the equipment.
                </div>
              </div>

            </div>

            <!-- Form Actions -->
            <div class="equipment-edit-form-footer">

              <a href="/equipment" class="btn equipment-edit-cancel">
                Cancel
              </a>

              <button
                type="submit"
                class="btn equipment-edit-save"
              >
                Save Changes
              </button>

            </div>

          </form>

        </div>

      </div>

      <!-- Information Sidebar -->
      <div class="col-lg-4">

        <div class="equipment-edit-sidebar">

          <div class="equipment-edit-sidebar-icon">
            &#9432;
          </div>

          <h5>Before You Save</h5>

          <p>
            Review the following details before updating the equipment record.
          </p>

          <div class="equipment-edit-tip">
            <span class="equipment-edit-tip-marker"></span>

            <div>
              <strong>Equipment Code</strong>
              <p>Make sure the code is unique.</p>
            </div>
          </div>

          <div class="equipment-edit-tip">
            <span class="equipment-edit-tip-marker"></span>

            <div>
              <strong>Equipment Details</strong>
              <p>Keep the name, category, and location accurate.</p>
            </div>
          </div>

          <div class="equipment-edit-tip">
            <span class="equipment-edit-tip-marker"></span>

            <div>
              <strong>Equipment Status</strong>
              <p>Choose the status that reflects its current condition.</p>
            </div>
          </div>

          <div class="equipment-edit-notice">
            <strong>Important</strong>
            <p>
              Your changes will be submitted when you select Save Changes.
            </p>
          </div>

        </div>

      </div>

    </div>

  </main>

  <!-- Footer -->
  <%- include("partials/footer") %>

  <!-- Bootstrap JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>