<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>Edit Work Order | MaintainXPro</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
/>

<link rel="stylesheet" href="/css/style.css">


</head>

<body>


<%- include("partials/navbar") %>

<% const isManager = ["Admin", "Maintenance Manager"].includes(user.role); %>

<main class="container py-5 equipment-edit-page">

    <!-- PAGE HEADER -->
    <section class="equipment-edit-header">

        <a href="/work-orders" class="equipment-edit-back">
            &larr; Back to Work Orders
        </a>

        <div class="mt-4">

            <span class="equipment-edit-eyebrow">
                MAINTENANCE OPERATIONS
            </span>

            <h1 class="equipment-edit-title">
                Edit Work Order
            </h1>

            <p class="equipment-edit-description">
                Update maintenance task information and monitor its
                progress to keep maintenance operations organized.
            </p>

        </div>

    </section>

    <!-- MAIN CONTENT -->
    <div class="row g-4">

        <!-- EDIT FORM -->
        <div class="col-lg-8">

            <section class="equipment-edit-card">

                <!-- CARD HEADER -->
                <div class="equipment-edit-card-header">

                    <div class="equipment-edit-icon">
                        &#9998;
                    </div>

                    <div>

                        <h5>Work Order Information</h5>

                        <p>
                            <% if (isManager) { %>
                                Update the details of this maintenance task.
                            <% } else { %>
                                Update the progress of your assigned work order.
                            <% } %>
                        </p>

                    </div>

                </div>

                <!-- FORM START -->
                <form
                    id="work-order-edit-form"
                    action="/work-orders/<%= workOrder.id %>/edit"
                    method="POST"
                >

                    <!-- FORM BODY -->
                    <div class="equipment-edit-form-body">

                        <% if (isManager) { %>

                            <!-- WORK ORDER TITLE -->
                            <div class="mb-4">

                                <label for="title" class="form-label">
                                    Work Order Title
                                    <span class="required-mark">*</span>
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    id="title"
                                    name="title"
                                    maxlength="200"
                                    value="<%= workOrder.title %>"
                                    required
                                >

                                <div class="form-text">
                                    Provide a clear and descriptive title for the maintenance task.
                                </div>

                            </div>

                            <!-- DESCRIPTION -->
                            <div class="mb-4">

                                <label for="description" class="form-label">
                                    Description
                                </label>

                                <textarea
                                    class="form-control"
                                    id="description"
                                    name="description"
                                    rows="4"
                                ><%= workOrder.description || "" %></textarea>

                                <div class="form-text">
                                    Describe the maintenance work or issue that needs attention.
                                </div>

                            </div>

                            <!-- EQUIPMENT -->
                            <div class="mb-4">

                                <label for="equipment_id" class="form-label">
                                    Equipment
                                    <span class="required-mark">*</span>
                                </label>

                                <select
                                    class="form-select"
                                    id="equipment_id"
                                    name="equipment_id"
                                    required
                                >

                                    <% equipment.forEach(item => { %>

                                        <option
                                            value="<%= item.id %>"
                                            <%= String(workOrder.equipment_id) === String(item.id) ? "selected" : "" %>
                                        >
                                            <%= item.equipment_code %> - <%= item.name %>
                                        </option>

                                    <% }) %>

                                </select>

                                <div class="form-text">
                                    Select the equipment associated with this work order.
                                </div>

                            </div>

                            <!-- ASSIGNED TECHNICIAN -->
                            <div class="mb-4">

                                <label for="assigned_to" class="form-label">
                                    Assigned Technician
                                    <span class="required-mark">*</span>
                                </label>

                                <select
                                    class="form-select"
                                    id="assigned_to"
                                    name="assigned_to"
                                    required
                                >

                                    <% technicians.forEach(technician => { %>

                                        <option
                                            value="<%= technician.id %>"
                                            <%= String(workOrder.assigned_to || "") === String(technician.id) ? "selected" : "" %>
                                        >
                                            <%= technician.full_name %>
                                        </option>

                                    <% }) %>

                                </select>

                                <div class="form-text">
                                    Select the technician responsible for completing the task.
                                </div>

                            </div>

                            <!-- PRIORITY -->
                            <div class="mb-4">

                                <label for="priority" class="form-label">
                                    Priority
                                </label>

                                <select
                                    class="form-select"
                                    id="priority"
                                    name="priority"
                                    required
                                >

                                    <% ["Low", "Medium", "High"].forEach(priority => { %>

                                        <option
                                            value="<%= priority %>"
                                            <%= workOrder.priority === priority ? "selected" : "" %>
                                        >
                                            <%= priority %>
                                        </option>

                                    <% }) %>

                                </select>

                                <div class="form-text">
                                    Set the urgency level of this maintenance task.
                                </div>

                            </div>

                            <!-- DUE DATE -->
                            <div class="mb-4">

                                <label for="due_date" class="form-label">
                                    Due Date
                                </label>

                                <input
                                    type="date"
                                    class="form-control"
                                    id="due_date"
                                    name="due_date"
                                    value="<%= workOrder.due_date ? new Date(workOrder.due_date).toISOString().slice(0, 10) : '' %>"
                                >

                                <div class="form-text">
                                    Set the target completion date.
                                </div>

                            </div>

                        <% } else { %>

                            <!-- TECHNICIAN INFORMATION -->
                            <div class="alert alert-secondary">
                                You can update the status of the work order assigned to you.
                            </div>

                            <div class="mb-4">

                                <label class="form-label">
                                    Work Order
                                </label>

                                <p class="form-control-plaintext text-light mb-0">
                                    <%= workOrder.title %>
                                </p>

                            </div>

                        <% } %>

                        <!-- STATUS -->
                        <div class="mb-4">

                            <label for="status" class="form-label">
                                Work Order Status
                            </label>

                            <select
                                class="form-select"
                                id="status"
                                name="status"
                                required
                            >

                                <option
                                    value="Open"
                                    <%= workOrder.status === "Open" ? "selected" : "" %>
                                >
                                    Open
                                </option>

                                <option
                                    value="In Progress"
                                    <%= workOrder.status === "In Progress" ? "selected" : "" %>
                                >
                                    In Progress
                                </option>

                                <% if (isManager) { %>

                                    <option
                                        value="Completed"
                                        <%= workOrder.status === "Completed" ? "selected" : "" %>
                                    >
                                        Completed
                                    </option>

                                <% } %>

                            </select>

                            <div class="form-text">
                                Update the current progress of the maintenance task.
                            </div>

                        </div>

                    </div>

                    <!-- FORM FOOTER -->
                    <div class="equipment-edit-form-footer">

                        <a
                            href="/work-orders"
                            class="equipment-edit-cancel"
                        >
                            Cancel
                        </a>

                        <button
                            type="submit"
                            class="equipment-edit-save"
                        >
                            Save Changes
                        </button>

                    </div>

                </form>
                <!-- FORM END -->

            </section>

        </div>

        <!-- INFORMATION SIDEBAR -->
        <div class="col-lg-4">

            <aside class="equipment-edit-sidebar">

                <div class="equipment-edit-sidebar-icon">
                    &#9432;
                </div>

                <h5>Before you save</h5>

                <p>
                    Keep maintenance activities accurate and up to date.
                    Proper work order management helps technicians and
                    managers coordinate maintenance tasks effectively.
                </p>

                <!-- TIP 1 -->
                <div class="equipment-edit-tip">

                    <span class="equipment-edit-tip-marker"></span>

                    <div>

                        <strong>Review Work Details</strong>

                        <p>
                            Ensure the work order title and description
                            accurately reflect the required maintenance.
                        </p>

                    </div>

                </div>

                <!-- TIP 2 -->
                <div class="equipment-edit-tip">

                    <span class="equipment-edit-tip-marker"></span>

                    <div>

                        <strong>Verify Assignment</strong>

                        <p>
                            Make sure the correct technician is assigned
                            to the maintenance task.
                        </p>

                    </div>

                </div>

                <!-- TIP 3 -->
                <div class="equipment-edit-tip">

                    <span class="equipment-edit-tip-marker"></span>

                    <div>

                        <strong>Monitor Priority</strong>

                        <p>
                            Keep the priority level aligned with the urgency
                            of the maintenance requirement.
                        </p>

                    </div>

                </div>

                <!-- TIP 4 -->
                <div class="equipment-edit-tip">

                    <span class="equipment-edit-tip-marker"></span>

                    <div>

                        <strong>Update Work Status</strong>

                        <p>
                            Maintain accurate progress information so
                            maintenance activities can be tracked.
                        </p>

                    </div>

                </div>

                <!-- IMPORTANT NOTICE -->
                <div class="equipment-edit-notice">

                    <strong>Important Reminder</strong>

                    <p>
                        Save your changes after updating the work order
                        to ensure the latest information is recorded.
                    </p>

                </div>

            </aside>

        </div>

    </div>

</main>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
