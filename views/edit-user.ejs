<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit User | MaintainXPro</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/navbar") %>

    <main class="container py-5 equipment-edit-page">

        <!-- Page Header -->
        <div class="equipment-edit-header mb-4">

        <a href="/users" class="equipment-edit-back">
            &larr; Back to Users
        </a>

        <div class="equipment-edit-eyebrow">
            USER MANAGEMENT
        </div>

        <h1 class="equipment-edit-title">
            Edit User
        </h1>

        <p class="equipment-edit-description">
            Update account information, access credentials, and user role.
        </p>

        </div>

        <div class="row g-4">

        <!-- Main Form -->
        <div class="col-lg-8">

            <div class="equipment-edit-card">

            <div class="equipment-edit-card-header">

                <div class="equipment-edit-icon">
                    &#9998;
                </div>

                <div>
                <h2 class="h5 mb-1">User Information</h2>
                <p class="mb-0">
                    Modify the user's account details below.
                </p>
                </div>

            </div>

            <div class="equipment-edit-form-body">

                <% if (error) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error %>
                </div>
                <% } %>

                <form
                id="edit-user-form"
                action="/users/<%= user.id %>/edit"
                method="POST"
                >

                <!-- Full Name -->
                <div class="mb-4">

                    <label for="full_name" class="form-label">
                    Full Name <span class="required-mark">*</span>
                    </label>

                    <input
                    type="text"
                    class="form-control"
                    id="full_name"
                    name="full_name"
                    value="<%= user.full_name %>"
                    maxlength="150"
                    required
                    >

                    <div class="form-text">
                    Enter the user's complete name.
                    </div>

                </div>

                <!-- Email -->
                <div class="mb-4">

                    <label for="email" class="form-label">
                    Email Address <span class="required-mark">*</span>
                    </label>

                    <input
                    type="email"
                    class="form-control"
                    id="email"
                    name="email"
                    value="<%= user.email %>"
                    maxlength="255"
                    required
                    >

                    <div class="form-text">
                    This email address identifies the user's account.
                    </div>

                </div>

                <!-- Password -->
                <div class="mb-4">

                    <label for="password" class="form-label">
                    New Password
                    </label>

                    <input
                    type="password"
                    class="form-control"
                    id="password"
                    name="password"
                    minlength="8"
                    autocomplete="new-password"
                    placeholder="Leave blank to keep the current password"
                    >

                    <div class="form-text">
                    Leave blank to retain the current password.
                    If changing it, enter at least 8 characters.
                    </div>

                </div>

                <!-- Role -->
                <div class="mb-4">

                    <label for="role" class="form-label">
                    User Role <span class="required-mark">*</span>
                    </label>

                    <select
                    class="form-select"
                    id="role"
                    name="role"
                    required
                    >

                    <option
                        value="Technician"
                        <%= user.role === "Technician" ? "selected" : "" %>
                    >
                        Technician
                    </option>

                    <option
                        value="Maintenance Manager"
                        <%= user.role === "Maintenance Manager" ? "selected" : "" %>
                    >
                        Maintenance Manager
                    </option>

                    <option
                        value="Admin"
                        <%= user.role === "Admin" ? "selected" : "" %>
                    >
                        Admin
                    </option>

                    </select>

                    <div class="form-text">
                    The assigned role determines the user's system access.
                    </div>

                </div>

                </form>

            </div>

            <!-- Form Actions -->
            <div class="equipment-edit-form-footer">

                <a href="/users" class="equipment-edit-cancel">
                Cancel
                </a>

                <button
                type="submit"
                form="edit-user-form"
                class="equipment-edit-save"
                >
                Save Changes
                </button>

            </div>

            </div>

        </div>

        <!-- Guidance Sidebar -->
        <div class="col-lg-4">

            <div class="equipment-edit-sidebar">

            <div class="equipment-edit-sidebar-icon">
                &#9432;
            </div>

            <h2 class="h5 mb-2">Before you save</h2>

            <p class="text-secondary">
                Keep user account information accurate and secure.
            </p>

            <div class="equipment-edit-tip">

                <div class="equipment-edit-tip-marker"></div>

                <div>
                <h3 class="h6">Account Details</h3>
                <p>
                    Make sure the user's name and email address are correct.
                </p>
                </div>

            </div>

            <div class="equipment-edit-tip">

                <div class="equipment-edit-tip-marker"></div>

                <div>
                <h3 class="h6">Password Security</h3>
                <p>
                    Leave the password field blank if no password change is needed.
                </p>
                </div>

            </div>

            <div class="equipment-edit-tip">

                <div class="equipment-edit-tip-marker"></div>

                <div>
                <h3 class="h6">User Permissions</h3>
                <p>
                    Assign the appropriate role based on the user's responsibilities.
                </p>
                </div>

            </div>

            <div class="equipment-edit-notice">
                <strong>Important:</strong>
                Changing a user's role may change which features and records
                they can access.
            </div>

            </div>

        </div>

        </div>

    </main>

    <%- include("partials/footer") %>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

</body>
</html>