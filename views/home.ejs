<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>MaintainXPro | Smart Maintenance Management</title>

    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <%- include("partials/navbar") %>

    <main class="main-content container py-5">
      <!-- Hero Section -->
      <section class="home-hero mb-5">
        <div class="row align-items-center g-5">
          <!-- Hero Text -->
          <div class="col-12 col-lg-7">
            <div class="hero-content">
              <div class="hero-eyebrow mb-4">
                <span class="hero-status-dot"></span>
                MAINTENANCE MANAGEMENT PLATFORM
              </div>

              <h1 class="home-hero-title fw-bold mb-4">
                Keep Your Assets
                <span class="brand-accent">Running.</span>
                <br />
                Keep Your Operations
                <span class="hero-highlight">Moving.</span>
              </h1>

              <p class="home-hero-description mb-4">
                Take control of your maintenance operations with one centralized
                platform for equipment, preventive maintenance, and work orders.
                Stay organized, make informed decisions, and keep your team on
                track.
              </p>

              <div class="d-flex flex-wrap gap-3 mb-4">
                <a
                  href="/dashboard"
                  class="btn btn-primary btn-lg home-primary-btn"
                >
                  Open Dashboard <span aria-hidden="true">&rarr;</span>
                </a>

                <a
                  href="#platform-features"
                  class="btn home-secondary-btn btn-lg"
                >
                  Explore Features
                </a>
              </div>

              <div class="hero-trust-note">
                <span class="hero-trust-icon" aria-hidden="true">&#10003;</span>
                One platform. Better maintenance control.
              </div>
            </div>
          </div>

          <!-- Visual Panel -->
          <div class="col-12 col-lg-5">
            <div class="hero-visual">
              <div class="hero-visual-glow"></div>

              <div class="hero-panel">
                <div class="hero-panel-header">
                  <div>
                    <div class="hero-panel-label">SYSTEM OVERVIEW</div>
                    <h2 class="hero-panel-title">Maintenance Control</h2>
                  </div>

                  <span class="hero-live-badge">
                    <span class="hero-status-dot"></span>
                    Organized
                  </span>
                </div>

                <div class="hero-panel-divider"></div>

                <div class="hero-feature-row">
                  <div
                    class="hero-feature-icon equipment-icon"
                    aria-hidden="true"
                  >
                    &#9881;
                  </div>

                  <div class="flex-grow-1">
                    <h3>Equipment Management</h3>
                    <p>Keep asset information organized</p>
                  </div>

                  <span class="hero-row-arrow" aria-hidden="true">&rarr;</span>
                </div>

                <div class="hero-feature-row">
                  <div
                    class="hero-feature-icon schedule-icon"
                    aria-hidden="true"
                  >
                    &#128197;
                  </div>

                  <div class="flex-grow-1">
                    <h3>Preventive Maintenance</h3>
                    <p>Stay prepared for scheduled tasks</p>
                  </div>

                  <span class="hero-row-arrow" aria-hidden="true">&rarr;</span>
                </div>

                <div class="hero-feature-row">
                  <div
                    class="hero-feature-icon workorder-icon"
                    aria-hidden="true"
                  >
                    &#9776;
                  </div>

                  <div class="flex-grow-1">
                    <h3>Work Order Tracking</h3>
                    <p>Monitor maintenance activities</p>
                  </div>

                  <span class="hero-row-arrow" aria-hidden="true">&rarr;</span>
                </div>

                <div class="hero-panel-footer">
                  <span class="hero-footer-indicator"></span>
                  <span>Everything connected in one place</span>
                </div>
              </div>

              <div class="hero-floating-label">
                <span class="hero-floating-icon" aria-hidden="true"
                  >&#10003;</span
                >
                <div>
                  <strong>Stay in control</strong>
                  <span>From assets to work orders</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Platform Benefits -->
      <section class="home-benefits mb-5">
        <div class="row g-3">
          <div class="col-12 col-md-4">
            <div class="benefit-item">
              <span class="benefit-number">01</span>
              <div>
                <h3>Centralized Information</h3>
                <p>Keep important maintenance records in one place.</p>
              </div>
            </div>
          </div>

          <div class="col-12 col-md-4">
            <div class="benefit-item">
              <span class="benefit-number">02</span>
              <div>
                <h3>Better Visibility</h3>
                <p>Review equipment, schedules, and work orders more easily.</p>
              </div>
            </div>
          </div>

          <div class="col-12 col-md-4">
            <div class="benefit-item">
              <span class="benefit-number">03</span>
              <div>
                <h3>Organized Workflows</h3>
                <p>Keep maintenance activities structured and trackable.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section id="platform-features" class="home-features mb-5">
        <div class="features-heading mb-4">
          <div>
            <div class="section-eyebrow mb-2">BUILT FOR YOUR WORKFLOW</div>
            <h2 class="features-title fw-bold mb-2">
              Everything Under Control
            </h2>
            <p class="features-description mb-0">
              The essential tools to manage your maintenance operations with
              confidence.
            </p>
          </div>

          <a href="/dashboard" class="features-dashboard-link">
            Go to Dashboard <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="row g-4">
          <!-- Equipment Management -->
          <div class="col-12 col-md-4">
            <article class="feature-card feature-card-equipment h-100">
              <div class="feature-card-top">
                <div class="feature-icon" aria-hidden="true">&#9881;</div>
                <span class="feature-index">01 / ASSETS</span>
              </div>

              <h3>Equipment Management</h3>

              <p>
                Maintain a clear record of your equipment, including asset
                codes, locations, categories, and operational status.
              </p>

              <a href="/equipment" class="feature-link">
                Manage Equipment <span aria-hidden="true">&rarr;</span>
              </a>
            </article>
          </div>

          <!-- Maintenance Scheduling -->
          <div class="col-12 col-md-4">
            <article class="feature-card feature-card-schedule h-100">
              <div class="feature-card-top">
                <div class="feature-icon" aria-hidden="true">&#128197;</div>
                <span class="feature-index">02 / PLANNING</span>
              </div>

              <h3>Maintenance Scheduling</h3>

              <p>
                Organize preventive maintenance schedules and keep upcoming
                maintenance activities visible to your team.
              </p>

              <a href="/maintenance-schedules" class="feature-link">
                View Schedules <span aria-hidden="true">&rarr;</span>
              </a>
            </article>
          </div>

          <!-- Work Order Tracking -->
          <div class="col-12 col-md-4">
            <article class="feature-card feature-card-workorders h-100">
              <div class="feature-card-top">
                <div class="feature-icon" aria-hidden="true">&#9776;</div>
                <span class="feature-index">03 / EXECUTION</span>
              </div>

              <h3>Work Order Tracking</h3>

              <p>
                Create work orders, coordinate assignments, and monitor task
                priorities and completion statuses.
              </p>

              <a href="/work-orders" class="feature-link">
                Manage Work Orders <span aria-hidden="true">&rarr;</span>
              </a>
            </article>
          </div>
        </div>
      </section>

      <!-- Bottom Call to Action -->
      <section class="home-cta">
        <div class="home-cta-content">
          <div class="section-eyebrow mb-2">YOUR MAINTENANCE WORKSPACE</div>

          <h2 class="fw-bold mb-3">Ready to take control?</h2>

          <p class="mb-4">
            Bring your maintenance information together and keep your operations
            organized.
          </p>

          <a href="/dashboard" class="btn btn-primary btn-lg home-primary-btn">
            Get Started <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="home-cta-decoration" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <%- include("partials/footer") %>

    <!-- Bootstrap 5 JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
