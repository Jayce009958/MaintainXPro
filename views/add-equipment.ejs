<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>Add Equipment | MaintainXPro</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

<link rel="stylesheet" href="/css/style.css">


</head>

<body>
    <%- include("partials/navbar") %>


<main class="container py-5 equipment-form-page">

    <!-- Back Navigation -->
    <a href="/equipment" class="equipment-back-link">
        &larr; Back to Equipment
    </a>

    <!-- Page Header -->
    <section class="equipment-form-hero mt-4 mb-4">
        <span class="equipment-eyebrow">ASSET MANAGEMENT</span>

        <h1 class="equipment-heading">Add Equipment.</h1>

        <p class="equipment-subtitle">
            Register a new asset and add it to your organization's
            maintenance inventory.
        </p>
    </section>

    <!-- Form Layout -->
    <div class="row g-4">

        <!-- Main Form -->
        <div class="col-12 col-lg-8">

            <section class="equipment-form-panel">

                <div class="equipment-form-panel-header">
                    <div class="equipment-form-icon">01</div>

                    <div>
                        <h2>Equipment Information</h2>
                        <p>Enter the details for the new equipment.</p>
                    </div>
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger equipment-form-alert" role="alert">
                        <strong>Unable to save equipment.</strong>
                        <div><%= error %></div>
                    </div>
                <% } %>

                <form action="/equipment/new" method="POST">

                    <div class="row g-3">

                        <!-- Equipment Code -->
                        <div class="col-12 col-md-6">
                            <label for="equipment_code" class="form-label">
                                Equipment Code
                                <span class="text-danger">*</span>
                            </label>

                            <input
                                type="text"
                                class="form-control equipment-form-input"
                                id="equipment_code"
                                name="equipment_code"
                                placeholder="e.g., EQ-002"
                                maxlength="100"
                                value="<%= typeof formData !== 'undefined' ? formData.equipment_code : '' %>"
                                autocomplete="off"
                                required
                            >

                            <div class="equipment-field-help">
                                Use a unique code to identify this asset.
                            </div>
                        </div>

                        <!-- Equipment Name -->
                        <div class="col-12 col-md-6">
                            <label for="name" class="form-label">
                                Equipment Name
                                <span class="text-danger">*</span>
                            </label>

                            <input
                                type="text"
                                class="form-control equipment-form-input"
                                id="name"
                                name="name"
                                placeholder="e.g., Air Conditioning Unit"
                                maxlength="255"
                                value="<%= typeof formData !== 'undefined' ? formData.name : '' %>"
                                required
                            >

                            <div class="equipment-field-help">
                                Enter a recognizable name for the asset.
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="col-12 col-md-6">
                            <label for="category" class="form-label">
                                Category
                            </label>

                            <input
                                type="text"
                                class="form-control equipment-form-input"
                                id="category"
                                name="category"
                                placeholder="e.g., HVAC, Electrical"
                                maxlength="100"
                                value="<%= typeof formData !== 'undefined' ? formData.category : '' %>"
                            >

                            <div class="equipment-field-help">
                                Specify the equipment type, if applicable.
                            </div>
                        </div>

                        <!-- Location -->
                        <div class="col-12 col-md-6">
                            <label for="location" class="form-label">
                                Location
                            </label>

                            <input
                                type="text"
                                class="form-control equipment-form-input"
                                id="location"
                                name="location"
                                placeholder="e.g., Main Office"
                                maxlength="255"
                                value="<%= typeof formData !== 'undefined' ? formData.location : '' %>"
                            >

                            <div class="equipment-field-help">
                                Identify where the equipment is located.
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="col-12">
                            <label for="status" class="form-label">
                                Equipment Status
                                <span class="text-danger">*</span>
                            </label>

                            <select
                                class="form-select equipment-form-input"
                                id="status"
                                name="status"
                                required
                            >
                                <option
                                    value="Operational"
                                    <%= typeof formData === 'undefined' || formData.status === 'Operational' ? 'selected' : '' %>
                                >
                                    Operational
                                </option>

                                <option
                                    value="Under Maintenance"
                                    <%= typeof formData !== 'undefined' && formData.status === 'Under Maintenance' ? 'selected' : '' %>
                                >
                                    Under Maintenance
                                </option>

                                <option
                                    value="Out of Service"
                                    <%= typeof formData !== 'undefined' && formData.status === 'Out of Service' ? 'selected' : '' %>
                                >
                                    Out of Service
                                </option>
                            </select>

                            <div class="equipment-field-help">
                                Select the equipment's current operating status.
                            </div>
                        </div>

                    </div>

                    <!-- Form Actions -->
                    <div class="equipment-form-actions">

                        <button
                            type="submit"
                            class="equipment-primary-btn"
                        >
                            Save Equipment
                        </button>

                        <a
                            href="/equipment"
                            class="equipment-clear-btn"
                        >
                            Cancel
                        </a>

                    </div>

                </form>

            </section>

        </div>

        <!-- Information Panel -->
        <div class="col-12 col-lg-4">

            <aside class="equipment-guidance-panel">

                <span class="equipment-panel-eyebrow">QUICK GUIDE</span>

                <h2>Before You Save</h2>

                <p class="equipment-guidance-intro">
                    Follow these guidelines when registering equipment.
                </p>

                <div class="equipment-guidance-item">
                    <span class="equipment-guidance-number">01</span>

                    <div>
                        <h3>Unique Equipment Code</h3>
                        <p>
                            Each asset must have a unique code so it can
                            be identified easily.
                        </p>
                    </div>
                </div>

                <div class="equipment-guidance-item">
                    <span class="equipment-guidance-number">02</span>

                    <div>
                        <h3>Accurate Information</h3>
                        <p>
                            Use a clear name and provide the category
                            and location when known.
                        </p>
                    </div>
                </div>

                <div class="equipment-guidance-item">
                    <span class="equipment-guidance-number">03</span>

                    <div>
                        <h3>Correct Status</h3>
                        <p>
                            Select the current status to help your team
                            monitor equipment condition.
                        </p>
                    </div>
                </div>

                <div class="equipment-guidance-note">
                    <strong>Note:</strong>
                    Fields marked with an asterisk (*) are required.
                </div>

            </aside>

        </div>

    </div>

</main>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
