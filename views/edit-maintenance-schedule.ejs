<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Maintenance Schedule | MaintainXPro</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/navbar") %>

    <main class="container py-5 equipment-form-page">

        <!-- Back Navigation -->
        <a href="/maintenance-schedules" class="equipment-back-link">
            &larr; Back to Maintenance Schedules
        </a>

        <!-- Page Header -->
        <section class="equipment-form-hero mt-4 mb-4">

            <span class="equipment-eyebrow">
                MAINTENANCE MANAGEMENT
            </span>

            <h1 class="equipment-heading">
                Edit Maintenance Schedule.
            </h1>

            <p class="equipment-subtitle">
                Update the maintenance plan and scheduling information
                for your equipment.
            </p>

        </section>

        <!-- Form Layout -->
        <div class="row g-4">

            <!-- Main Form -->
            <div class="col-12 col-lg-8">

                <section class="equipment-form-panel">

                    <div class="equipment-form-panel-header">

                        <div class="equipment-edit-icon">
                            &#9998;
                        </div>

                        <div>
                            <h2>Schedule Information</h2>
                            <p>Modify the details of this maintenance schedule.</p>
                        </div>

                    </div>

                    <form
                        action="/maintenance-schedules/<%= schedule.id %>/edit"
                        method="POST"
                    >

                        <div class="row g-3">

                            <!-- Equipment -->
                            <div class="col-12">

                                <label for="equipment_id" class="form-label">
                                    Equipment
                                    <span class="text-danger">*</span>
                                </label>

                                <select
                                    class="form-select equipment-form-input"
                                    id="equipment_id"
                                    name="equipment_id"
                                    required
                                >

                                    <option value="">Select equipment</option>

                                    <% equipment.forEach((item) => { %>

                                        <option
                                            value="<%= item.id %>"
                                            <%= Number(schedule.equipment_id) === Number(item.id) ? "selected" : "" %>
                                        >
                                            <%= item.equipment_code %> - <%= item.name %>
                                        </option>

                                    <% }) %>

                                </select>

                                <div class="equipment-field-help">
                                    Select the equipment associated with this maintenance schedule.
                                </div>

                            </div>

                            <!-- Maintenance Task -->
                            <div class="col-12">

                                <label for="title" class="form-label">
                                    Maintenance Task
                                    <span class="text-danger">*</span>
                                </label>

                                <input
                                    type="text"
                                    class="form-control equipment-form-input"
                                    id="title"
                                    name="title"
                                    value="<%= schedule.title %>"
                                    maxlength="255"
                                    required
                                >

                                <div class="equipment-field-help">
                                    Update the description of the maintenance activity.
                                </div>

                            </div>

                            <!-- Frequency -->
                            <div class="col-12 col-md-6">

                                <label for="frequency" class="form-label">
                                    Maintenance Frequency
                                    <span class="text-danger">*</span>
                                </label>

                                <select
                                    class="form-select equipment-form-input"
                                    id="frequency"
                                    name="frequency"
                                    required
                                >

                                    <option value="Daily" <%= schedule.frequency === "Daily" ? "selected" : "" %>>
                                        Daily
                                    </option>

                                    <option value="Weekly" <%= schedule.frequency === "Weekly" ? "selected" : "" %>>
                                        Weekly
                                    </option>

                                    <option value="Monthly" <%= schedule.frequency === "Monthly" ? "selected" : "" %>>
                                        Monthly
                                    </option>

                                    <option value="Quarterly" <%= schedule.frequency === "Quarterly" ? "selected" : "" %>>
                                        Quarterly
                                    </option>

                                    <option value="Semi-annually" <%= schedule.frequency === "Semi-annually" ? "selected" : "" %>>
                                        Semi-annually
                                    </option>

                                    <option value="Annually" <%= schedule.frequency === "Annually" ? "selected" : "" %>>
                                        Annually
                                    </option>

                                </select>

                                <div class="equipment-field-help">
                                    Update how frequently this maintenance task should be performed.
                                </div>

                            </div>

                            <!-- Next Maintenance Date -->
                            <div class="col-12 col-md-6">

                                <label for="next_maintenance_date" class="form-label">
                                    Next Maintenance Date
                                    <span class="text-danger">*</span>
                                </label>

                                <input
                                    type="date"
                                    class="form-control equipment-form-input"
                                    id="next_maintenance_date"
                                    name="next_maintenance_date"
                                    value="<%= schedule.next_maintenance_date instanceof Date ? schedule.next_maintenance_date.toISOString().slice(0, 10) : String(schedule.next_maintenance_date).slice(0, 10) %>"
                                    required
                                >

                                <div class="equipment-field-help">
                                    Update the next scheduled maintenance date.
                                </div>

                            </div>

                        </div>

                        <!-- Form Actions -->
                        <div class="equipment-form-actions">

                            <button
                                type="submit"
                                class="equipment-primary-btn"
                            >
                                Save Changes
                            </button>

                            <a
                                href="/maintenance-schedules"
                                class="equipment-clear-btn"
                            >
                                Cancel
                            </a>

                        </div>

                    </form>

                </section>

            </div>

            <!-- Information Panel -->
            <div class="col-12 col-lg-4">

                <aside class="equipment-guidance-panel">

                    <div class="equipment-edit-sidebar-icon">
                        &#9432;
                    </div>

                    <h5>Before You Save</h5>

                    <p class="equipment-guidance-intro">
                        Check the following details before updating your maintenance schedule.
                    </p>

                    <!-- Guide 1 -->
                    <div class="equipment-guidance-item">

                        <span class="equipment-guidance-number">
                            01
                        </span>

                        <div>
                            <h3>Verify Equipment</h3>

                            <p>
                                Make sure the correct equipment is associated
                                with this maintenance plan.
                            </p>
                        </div>

                    </div>

                    <!-- Guide 2 -->
                    <div class="equipment-guidance-item">

                        <span class="equipment-guidance-number">
                            02
                        </span>

                        <div>
                            <h3>Review Maintenance Task</h3>

                            <p>
                                Keep the task description clear and specific
                                for the maintenance team.
                            </p>
                        </div>

                    </div>

                    <!-- Guide 3 -->
                    <div class="equipment-guidance-item">

                        <span class="equipment-guidance-number">
                            03
                        </span>

                        <div>
                            <h3>Confirm Frequency</h3>

                            <p>
                                Ensure the maintenance interval is appropriate
                                for the equipment.
                            </p>
                        </div>

                    </div>

                    <!-- Guide 4 -->
                    <div class="equipment-guidance-item">

                        <span class="equipment-guidance-number">
                            04
                        </span>

                        <div>
                            <h3>Check Maintenance Date</h3>

                            <p>
                                Verify the next maintenance date before
                                saving your changes.
                            </p>
                        </div>

                    </div>

                    <!-- Note -->
                    <div class="equipment-guidance-note">

                        <strong>Note:</strong>

                        Review all updated information before selecting Save Changes.

                    </div>

                </aside>

            </div>

        </div>

    </main>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>