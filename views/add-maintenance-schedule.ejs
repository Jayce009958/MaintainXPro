<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Maintenance Schedule | MaintainXPro</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/navbar") %>

    <main class="container py-5 equipment-form-page">

        <!-- Back Navigation -->
        <a href="/maintenance-schedules" class="equipment-back-link">
            &larr; Back to Maintenance Schedules
        </a>

        <!-- Page Header -->
        <section class="equipment-form-hero mt-4 mb-4">

            <span class="equipment-eyebrow">
                MAINTENANCE MANAGEMENT
            </span>

            <h1 class="equipment-heading">
                Add Maintenance Schedule.
            </h1>

            <p class="equipment-subtitle">
                Create a preventive maintenance plan and keep your
                organization's equipment operating reliably.
            </p>

        </section>

        <!-- Form Layout -->
        <div class="row g-4">

            <!-- Main Form -->
            <div class="col-12 col-lg-8">

                <section class="equipment-form-panel">

                    <div class="equipment-form-panel-header">

                        <div class="equipment-form-icon">
                            01
                        </div>

                        <div>
                            <h2>Schedule Information</h2>
                            <p>Enter the details for the maintenance schedule.</p>
                        </div>

                    </div>

                    <% if (typeof error !== 'undefined' && error) { %>

                        <div class="alert alert-danger equipment-form-alert" role="alert">
                            <strong>Unable to save maintenance schedule.</strong>
                            <div><%= error %></div>
                        </div>

                    <% } %>

                    <form action="/maintenance-schedules/new" method="POST">

                        <div class="row g-3">

                            <!-- Equipment -->
                            <div class="col-12">

                                <label for="equipment_id" class="form-label">
                                    Equipment
                                    <span class="text-danger">*</span>
                                </label>

                                <select
                                    class="form-select equipment-form-input"
                                    id="equipment_id"
                                    name="equipment_id"
                                    required
                                >

                                    <option value="">Select equipment</option>

                                    <% equipment.forEach((item) => { %>

                                        <option
                                            value="<%= item.id %>"
                                            <%= typeof formData !== 'undefined' && String(formData.equipment_id) === String(item.id) ? 'selected' : '' %>
                                        >
                                            <%= item.equipment_code %> - <%= item.name %>
                                        </option>

                                    <% }) %>

                                </select>

                                <div class="equipment-field-help">
                                    Select the equipment that requires scheduled maintenance.
                                </div>

                            </div>

                            <!-- Maintenance Task -->
                            <div class="col-12">

                                <label for="title" class="form-label">
                                    Maintenance Task
                                    <span class="text-danger">*</span>
                                </label>

                                <input
                                    type="text"
                                    class="form-control equipment-form-input"
                                    id="title"
                                    name="title"
                                    placeholder="e.g., Inspect electrical connections"
                                    maxlength="255"
                                    value="<%= typeof formData !== 'undefined' ? formData.title : '' %>"
                                    required
                                >

                                <div class="equipment-field-help">
                                    Enter a clear description of the maintenance activity.
                                </div>

                            </div>

                            <!-- Frequency -->
                            <div class="col-12 col-md-6">

                                <label for="frequency" class="form-label">
                                    Maintenance Frequency
                                    <span class="text-danger">*</span>
                                </label>

                                <select
                                    class="form-select equipment-form-input"
                                    id="frequency"
                                    name="frequency"
                                    required
                                >

                                    <option value="">Select frequency</option>

                                    <option value="Daily"
                                        <%= typeof formData !== 'undefined' && formData.frequency === 'Daily' ? 'selected' : '' %>>
                                        Daily
                                    </option>

                                    <option value="Weekly"
                                        <%= typeof formData !== 'undefined' && formData.frequency === 'Weekly' ? 'selected' : '' %>>
                                        Weekly
                                    </option>

                                    <option value="Monthly"
                                        <%= typeof formData !== 'undefined' && formData.frequency === 'Monthly' ? 'selected' : '' %>>
                                        Monthly
                                    </option>

                                    <option value="Quarterly"
                                        <%= typeof formData !== 'undefined' && formData.frequency === 'Quarterly' ? 'selected' : '' %>>
                                        Quarterly
                                    </option>

                                    <option value="Semi-annually"
                                        <%= typeof formData !== 'undefined' && formData.frequency === 'Semi-annually' ? 'selected' : '' %>>
                                        Semi-annually
                                    </option>

                                    <option value="Annually"
                                        <%= typeof formData !== 'undefined' && formData.frequency === 'Annually' ? 'selected' : '' %>>
                                        Annually
                                    </option>

                                </select>

                                <div class="equipment-field-help">
                                    Choose how frequently maintenance should be performed.
                                </div>

                            </div>

                            <!-- Next Maintenance Date -->
                            <div class="col-12 col-md-6">

                                <label for="next_maintenance_date" class="form-label">
                                    Next Maintenance Date
                                    <span class="text-danger">*</span>
                                </label>

                                <input
                                    type="date"
                                    class="form-control equipment-form-input"
                                    id="next_maintenance_date"
                                    name="next_maintenance_date"
                                    value="<%= typeof formData !== 'undefined' ? formData.next_maintenance_date : '' %>"
                                    required
                                >

                                <div class="equipment-field-help">
                                    Set the next scheduled maintenance date.
                                </div>

                            </div>

                        </div>

                        <!-- Form Actions -->
                        <div class="equipment-form-actions">

                            <button
                                type="submit"
                                class="equipment-primary-btn"
                            >
                                Save Schedule
                            </button>

                            <a
                                href="/maintenance-schedules"
                                class="equipment-clear-btn"
                            >
                                Cancel
                            </a>

                        </div>

                    </form>

                </section>

            </div>

            <!-- Information Panel -->
            <div class="col-12 col-lg-4">

                <aside class="equipment-guidance-panel">

                    <span class="equipment-panel-eyebrow">
                        QUICK GUIDE
                    </span>

                    <h2>Before You Save</h2>

                    <p class="equipment-guidance-intro">
                        Follow these guidelines when creating a maintenance schedule.
                    </p>

                    <!-- Guide 1 -->
                    <div class="equipment-guidance-item">

                        <span class="equipment-guidance-number">
                            01
                        </span>

                        <div>
                            <h3>Select Equipment</h3>

                            <p>
                                Choose the equipment that will receive
                                the scheduled maintenance activity.
                            </p>
                        </div>

                    </div>

                    <!-- Guide 2 -->
                    <div class="equipment-guidance-item">

                        <span class="equipment-guidance-number">
                            02
                        </span>

                        <div>
                            <h3>Define the Task</h3>

                            <p>
                                Provide a clear description so technicians
                                understand the required maintenance work.
                            </p>
                        </div>

                    </div>

                    <!-- Guide 3 -->
                    <div class="equipment-guidance-item">

                        <span class="equipment-guidance-number">
                            03
                        </span>

                        <div>
                            <h3>Set the Frequency</h3>

                            <p>
                                Select an appropriate maintenance interval
                                based on the equipment's requirements.
                            </p>
                        </div>

                    </div>

                    <!-- Guide 4 -->
                    <div class="equipment-guidance-item">

                        <span class="equipment-guidance-number">
                            04
                        </span>

                        <div>
                            <h3>Choose the Date</h3>

                            <p>
                                Set the next maintenance date to help
                                your team complete tasks on time.
                            </p>
                        </div>

                    </div>

                    <!-- Note -->
                    <div class="equipment-guidance-note">

                        <strong>Note:</strong>

                        Fields marked with an asterisk (*) are required.

                    </div>

                </aside>

            </div>

        </div>

    </main>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>