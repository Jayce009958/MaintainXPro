<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Users Management | MaintainXPro</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/navbar") %>

    <main class="container py-5 equipment-page">

        <!-- Page Header -->
        <section class="equipment-hero mb-4">

            <div class="equipment-hero-content">

                <span class="equipment-eyebrow">
                    USER MANAGEMENT
                </span>

                <h1 class="equipment-heading">
                    Users.
                </h1>

                <p class="equipment-subtitle">
                    Manage user accounts, access levels, and roles
                    across your MaintainXPro system.
                </p>

            </div>

            <a href="/users/new" class="equipment-primary-btn">
                <span aria-hidden="true">+</span>
                Add User
            </a>

        </section>


        <!-- Success Messages -->
        <% if (
            success === "created" ||
            success === "updated" ||
            success === "deleted"
        ) { %>

            <div
                class="alert alert-success alert-dismissible fade show equipment-alert mb-4"
                role="alert"
            >

                <strong>Success!</strong>

                <%= success === "created"
                    ? "User created successfully."
                    : success === "updated"
                    ? "User updated successfully."
                    : "User deleted successfully." %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>

            </div>

        <% } %>


        <!-- User Directory -->
        <section class="equipment-panel">

            <div class="equipment-panel-header inventory-header">

                <div>

                    <span class="equipment-panel-eyebrow">
                        SYSTEM ACCOUNTS
                    </span>

                    <h2>User Directory</h2>

                    <p>
                        View and manage registered users and their assigned roles.
                    </p>

                </div>

                <span class="equipment-record-count">
                    <%= users.length %> record<%= users.length === 1 ? "" : "s" %>
                </span>

            </div>


            <!-- Users Table -->
            <div class="table-responsive equipment-table-wrap">

                <table class="table table-hover align-middle mb-0 equipment-table">

                    <thead>

                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">FULL NAME</th>
                            <th scope="col">EMAIL ADDRESS</th>
                            <th scope="col">ROLE</th>
                            <th scope="col">DATE CREATED</th>
                            <th scope="col">ACTIONS</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% if (users.length > 0) { %>

                            <% users.forEach(user => { %>

                                <tr>

                                    <td>
                                        <span class="equipment-id">
                                            #<%= user.id %>
                                        </span>
                                    </td>

                                    <td>
                                        <div class="equipment-name">
                                            <%= user.full_name %>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="equipment-location">
                                            <%= user.email %>
                                        </span>
                                    </td>

                                    <td>

                                        <span class="equipment-badge badge-unknown">
                                            <span></span>
                                            <%= user.role %>
                                        </span>

                                    </td>

                                    <td>
                                        <span class="equipment-location">
                                            <%= user.created_at
                                                ? new Date(user.created_at).toLocaleDateString()
                                                : "N/A" %>
                                        </span>
                                    </td>

                                    <td>

                                        <div class="equipment-row-actions">

                                            <a
                                                href="/users/<%= user.id %>/edit"
                                                class="equipment-action-btn action-edit"
                                            >
                                                Edit
                                            </a>

                                            <form
                                                action="/users/<%= user.id %>/delete"
                                                method="POST"
                                                class="delete-confirm-form"
                                                data-delete-message="Are you sure you want to delete <%= user.full_name %>? This action cannot be undone."
                                            >

                                                <button
                                                    type="submit"
                                                    class="equipment-action-btn action-delete"
                                                >
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }); %>

                        <% } else { %>

                            <tr>

                                <td colspan="6">

                                    <div class="equipment-empty-state">

                                        <div class="equipment-empty-icon">
                                            —
                                        </div>

                                        <h3>No Users Found</h3>

                                        <p>
                                            There are currently no registered users.
                                            Add your first user to get started.
                                        </p>

                                        <a
                                            href="/users/new"
                                            class="equipment-primary-btn"
                                        >
                                            + Add Your First User
                                        </a>

                                    </div>

                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </section>

    </main>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>